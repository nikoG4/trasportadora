NODE_ENV=production
PORT=8080
# Use the Supabase Session Pooler for Cloud Run/IPv4 environments.
# Copy the exact pooler host from Supabase Dashboard > Connect.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-us-east-1.pooler.supabase.com:5432/postgres
JWT_SECRET=change-me-access-secret
REFRESH_TOKEN_SECRET=change-me-refresh-secret
CORS_ORIGIN=https://admin.example.com,https://cliente.example.com
GOOGLE_MAPS_API_KEY=
SMTP_HOST=
SMTP_USER=
SMTP_PASS=
WHATSAPP_PROVIDER=
STORAGE_BUCKET=
GCP_PROJECT_ID=
GCP_REGION=us-central1
