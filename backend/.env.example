# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Configuration
# Generate long random values locally. Never reuse values from documentation or commits.
JWT_SECRET=
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# SQLite Database (Legacy - for migration only)
SQLITE_DB_PATH=./transportadora.db

# Supabase Configuration
# For Cloud Run and other IPv4-only runtimes, use the Supavisor pooler string
# from Supabase Dashboard > Connect > Session pooler.
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@[YOUR-POOLER-HOST]:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database Configuration
# Use 'sqlite' for local development with SQLite
# Use 'supabase' for production with Supabase
DB_TYPE=sqlite

# Connection Pool Configuration (for Supabase)
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT=2000
DB_IDLE_TIMEOUT=30000

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload (if needed)
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Email Configuration (for future implementation)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@example.com

# Firebase Cloud Messaging para push real a app-chofer.
# Use una de estas dos opciones con el service account JSON de Firebase.
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Frontend URLs
FRONTEND_URL=http://localhost:5173
LANDING_URL=http://localhost:5174
