# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Configuration
JWT_SECRET=transportadora_secret_123
JWT_EXPIRES_IN=1h
REFRESH_TOKEN_SECRET=transportadora_refresh_secret_123

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# SQLite Database (Legacy - for migration only)
SQLITE_DB_PATH=./transportadora.db

# Supabase Configuration
# For Cloud Run and other IPv4-only runtimes, use the Supavisor pooler string
# from Supabase Dashboard > Connect > Session pooler. Do not assume aws-0:
# some projects use aws-1/aws-2 hosts.
DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-1-us-east-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Database Configuration
# Use 'sqlite' for local development with SQLite
# Use 'supabase' for production with Supabase
DB_TYPE=sqlite

# Connection Pool Configuration (for Supabase)
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_CONNECTION_TIMEOUT=2000
DB_IDLE_TIMEOUT=30000

# Logging
LOG_LEVEL=info

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload (if needed)
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads

# Email Configuration (for future implementation)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=noreply@transposaas.com

# Firebase Cloud Messaging para push real a app-chofer.
# Use una de estas dos opciones con el service account JSON de Firebase.
# FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Frontend URLs
FRONTEND_URL=http://localhost:5173
LANDING_URL=http://localhost:5174
